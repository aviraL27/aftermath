# Aftermath Configuration

# Google API Key for Gemma 4 (Primary provider)
GOOGLE_API_KEY=your_google_api_key_here

# Local Ollama for Gemma 4 (Fallback provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GEMMA_MODEL=gemma4:12b

# Mistral API Key (Apache-2.0 open-mistral-7b model)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=open-mistral-7b

# Aftermath Web UI Port
AFTERMATH_PORT=8000
AFTERMATH_HOST=127.0.0.1

# E2B Cloud Sandbox Runtime
E2B_API_KEY=your_e2b_api_key_here

